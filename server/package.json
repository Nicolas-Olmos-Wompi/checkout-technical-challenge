{
  "name": "boilerplate-ms-nestjs",
  "version": "1.2.2",
  "description": "",
  "author": "Wompi",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "concurrently npm:lint:src npm:lint:domain npm:lint:spec",
    "lint:fix": "concurrently npm:lint:fix:*",
    "lint:src": "eslint 'src/**/**.ts' --ignore-pattern 'src/**/*.spec.ts'",
    "lint:fix:src": "npm run lint:src -- --fix",
    "lint:domain": "eslint 'domain/**/**.ts' --ignore-pattern 'domain/**/*.spec.ts'",
    "lint:fix:domain": "npm run lint:domain -- --fix",
    "lint:spec": "eslint 'src/**/**.spec.ts' 'domain/**/**.spec.ts' '__mocks__/**/**.ts'",
    "lint:fix:spec": "npm run lint:spec -- --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/adapter/out/postgres/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "test:e2e": "jest --config e2e/jest-e2e.config.js",
    "test:e2e-cov": "jest --config e2e/jest-e2e.config.js --coverage"
  },
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1046.0",
    "@aws-sdk/lib-dynamodb": "3.1046.0",
    "@aws-sdk/rds-signer": "3.1046.0",
    "@grpc/grpc-js": "1.14.3",
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.1.21",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.21",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.21",
    "@nestjs/swagger": "11.4.3",
    "@nestjs/typeorm": "11.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.76.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.218.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-metrics": "2.7.1",
    "@opentelemetry/sdk-node": "0.218.0",
    "@opentelemetry/sdk-trace-base": "2.7.1",
    "@opentelemetry/sdk-trace-node": "2.7.1",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "axios": "1.16.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "jwks-rsa": "4.0.1",
    "nestjs-cls": "~6.2.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.20.0",
    "rxjs": "7.8.2",
    "typeorm": "0.3.29"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.21",
    "@tsconfig/node24": "~24.0.4",
    "@types/eslint-config-prettier": "6.11.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.8.0",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.0",
    "concurrently": "9.2.1",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-unicorn": "64.0.0",
    "jest": "30.4.2",
    "jest-junit": "17.0.0",
    "jest-mock-extended": "4.0.1",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "overrides": {
    "protobufjs": "7.5.8",
    "typeorm": {
      "glob": {
        "minimatch": "9.0.7",
        "brace-expansion": "2.0.3"
      },
      "uuid": "14.0.0"
    }
  }
}
