# Application
APP_ENV=local
PORT=3000
SERVICE_NAME=boilerplate-ms-nestjs

# AWS
AWS_REGION=us-east-1
AWS_DYNAMODB_ENDPOINT=http://localhost:4566
AWS_DYNAMODB_TABLE_DOMAIN=domain-table
AWS_COGNITO_USER_POOL_ID=us-east-1_example

# Database (Postgres / TypeORM)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=boilerplate
DB_AUTH_MECHANISM=PASSWORD
DB_POOL_SIZE=10
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
DB_CONNECTION_TIMEOUT_IN_MS=5000
DB_IDLE_TIMEOUT_IN_MS=10000
DB_STATEMENT_TIMEOUT_IN_MS=10000
DB_QUERY_TIMEOUT_IN_MS=5000

# Observability
GRAFANA_AGENT_URL=http://localhost:4317

# Notifications
SLACK_WEBHOOK=https://hooks.slack.com/services/placeholder

# Auth (local JWT)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Wompi (sandbox)
WOMPI_BASE_URL=https://api-sandbox.co.uat.wompi.dev/v1
WOMPI_PUBLIC_KEY=replace-with-your-sandbox-public-key
WOMPI_PRIVATE_KEY=replace-with-your-sandbox-private-key
WOMPI_INTEGRITY_SECRET=replace-with-your-sandbox-integrity-secret
